{
  "name": "tidarr-main",
  "private": true,
  "workspaces": [
    "api",
    "app",
    "e2e"
  ],
  "scripts": {
    "app-build": "yarn --cwd ./app build",
    "api-build": "yarn --cwd ./api build",
    "dev": "concurrently -n api,front \"yarn --cwd ./api start\" \"yarn --cwd app start\"",
    "prod": "node ./api/dist/index.js",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint-fix": "oxlint -c .oxlintrc.json --fix .",
    "format": "oxfmt -c .oxfmtrc.json \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\"",
    "format-check": "oxfmt -c .oxfmtrc.json --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "brace-expansion": ">=5.0.1",
    "dompurify": ">=3.4.13",
    "flatted": ">=3.4.0",
    "linkify-it": ">=5.0.1",
    "minimatch": ">=10.2.3"
  }
}
