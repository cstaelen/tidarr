{
  "name": "tidarr-main",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "app-build": "pnpm --filter tidarr-react build",
    "api-build": "pnpm --filter tidarr-api build",
    "dev": "concurrently -n api,front \"pnpm --filter tidarr-api start\" \"pnpm --filter tidarr-react start\"",
    "prod": "node ./api/dist/index.js",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint-fix": "oxlint -c .oxlintrc.json --fix .",
    "format": "oxfmt -c .oxfmtrc.json \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\"",
    "format-check": "oxfmt -c .oxfmtrc.json --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.1",
      "dompurify": ">=3.4.13",
      "flatted": ">=3.4.0",
      "linkify-it": ">=5.0.1",
      "minimatch": ">=10.2.3"
    }
  }
}
